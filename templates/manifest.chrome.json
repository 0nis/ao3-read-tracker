{
  "manifest_version": 3,
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://archiveofourown.org/*"],
  "content_scripts": [
    {
      "matches": ["https://archiveofourown.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://archiveofourown.org/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start"
    }
  ]
}
