@startuml Google Drive Backup Creation Flow
title Google Drive Backup Creation Flow

skinparam participant<<external>> {
    BackgroundColor #F3F3F3
    BorderColor #888888
}

actor User
participant UI [
    =Options Page UI
    ""content script""
]
participant Service [
    =BackupService
    ""service""
]
participant Exporter [
    =IoService
    ""database export""
]
participant Proxy [
    =BackupRuntimeProxy
    ""content-side proxy""
]
participant BG [
    =Backup Background
    ""message router""
]
participant Handler [
    =GoogleBackupHandler
    ""handler""
]
participant Auth [
    =GoogleDeviceAuthHandler
    ""auth handler""
]
participant Client [
    =GoogleDriveClient
    ""client""
]
database "IndexedDB Storage" as Storage

participant Google <<external>> [
    =Google Drive API
]

User -> UI: Click "Create Google Drive Backup"
create Service
UI -> Service: import backupService singleton
UI -> Service: create()\nprovider GOOGLE_DRIVE

Service -> Service: getProxy(GOOGLE_DRIVE)
create Proxy
Service -> Proxy: new BackupRuntimeProxy(GOOGLE_DRIVE)

Service -> Proxy: isAvailable()
Proxy -> BG: runtime message IS_AVAILABLE\nprovider GOOGLE_DRIVE
BG -> BG: get/create handler for GOOGLE_DRIVE
create Handler
BG -> Handler: new GoogleBackupHandler()
create Client
Handler -> Client: new GoogleDriveClient(getAccessToken)
BG -> Handler: isAvailable()
create Auth
Handler -> Auth: new GoogleDeviceAuthHandler()
Handler -> Auth: getValidAccessToken()
Auth --> Handler: access token
Handler --> BG: true
BG --> Proxy: true
Proxy --> Service: true

Service -> Storage: read backup config

Service -> Proxy: getTarget(config)
Proxy -> BG: runtime message GET_TARGET\nprovider GOOGLE_DRIVE
BG -> BG: get cached handler for GOOGLE_DRIVE
BG -> Handler: getTarget(config)

alt saved target exists
  Handler -> Client: getFile(remoteTarget)
  Client -> Auth: getValidAccessToken()
  Auth --> Client: access token
  Client -> Google: GET /files/{folderId}
  Google --> Client: folder metadata
  Client --> Handler: existing folder
else no usable target
  Handler -> Client: createBackupFolder()
  Client -> Auth: getValidAccessToken()
  Auth --> Client: access token
  Client -> Google: POST /files\nfolder metadata
  Google --> Client: created folder
  Client --> Handler: created folder
end

Handler --> BG: BackupTarget
BG --> Proxy: BackupTarget
Proxy --> Service: BackupTarget

Service -> Exporter: export()
Exporter -> Storage: export IndexedDB database
Storage --> Exporter: JSON Blob
Exporter --> Service: JSON Blob

Service -> Service: create backup filename
Service -> Service: choose upload method\nbased on Blob size

alt small enough for direct upload
  Service -> Service: convert Blob to text

  Service -> Proxy: directUpload(target, fileName, content)
  Proxy -> BG: runtime message DIRECT_UPLOAD\nprovider GOOGLE_DRIVE
  BG -> BG: get cached handler for GOOGLE_DRIVE
  BG -> Handler: directUpload(input)
  Handler -> Client: uploadBackup(input)
  Client -> Auth: getValidAccessToken()
  Auth --> Client: access token
  Client -> Google: POST /upload/drive/v3/files\nmultipart metadata + JSON
  Google --> Client: uploaded file metadata
  Client --> Handler: uploaded file
  Handler --> BG: BackupFile
  BG --> Proxy: BackupFile
  Proxy --> Service: BackupFile

else large backup uses resumable upload
  Service -> Proxy: startUpload(target, fileName, sizeBytes)
  Proxy -> BG: runtime message START_UPLOAD\nprovider GOOGLE_DRIVE
  BG -> BG: get cached handler for GOOGLE_DRIVE
  BG -> Handler: startUpload(input)
  Handler -> Client: startResumableUpload(input)
  Client -> Auth: getValidAccessToken()
  Auth --> Client: access token
  Client -> Google: POST /upload/drive/v3/files\nuploadType=resumable\nmetadata only
  Google --> Client: resumable upload URL
  Client --> Handler: upload URL
  Handler -> Handler: store upload session\nuploadId -> upload URL
  Handler --> BG: uploadId
  BG --> Proxy: uploadId
  Proxy --> Service: uploadId

  loop For each Blob chunk
    Service -> Service: slice Blob chunk
    Service -> Service: convert chunk to base64

    Service -> Proxy: uploadChunk(uploadId, chunkBase64,\nbyte range)
    Proxy -> BG: runtime message UPLOAD_CHUNK\nprovider GOOGLE_DRIVE
    BG -> BG: get cached handler for GOOGLE_DRIVE
    BG -> Handler: uploadChunk(input)
    Handler -> Handler: get upload URL for uploadId
    Handler -> Client: uploadResumableChunk(uploadUrl,\nchunk, byte range)
    Client -> Google: PUT resumable upload URL\nContent-Range: bytes start-end/total

    alt upload incomplete
      Google --> Client: 308 Resume Incomplete
      Client --> Handler: not done
      Handler --> BG: done: false
      BG --> Proxy: done: false
      Proxy --> Service: done: false
    else final chunk uploaded
      Google --> Client: uploaded file metadata
      Client --> Handler: uploaded file
      Handler -> Handler: clear upload session
      Handler --> BG: done: true\nBackupFile
      BG --> Proxy: done: true\nBackupFile
      Proxy --> Service: done: true\nBackupFile
    end
  end
end

Service -> Storage: update backup config\nremoteTarget + lastBackedUpAt

opt Retention enabled
  Service -> Service: prune()

  Service -> Proxy: list(target)
  Proxy -> BG: runtime message LIST\nprovider GOOGLE_DRIVE
  BG -> BG: get cached handler for GOOGLE_DRIVE
  BG -> Handler: list(target)
  Handler -> Client: listBackups(folderId)
  Client -> Auth: getValidAccessToken()
  Auth --> Client: access token
  Client -> Google: GET /files\nbackup query
  Google --> Client: backup files
  Client --> Handler: backup files
  Handler --> BG: BackupFile[]
  BG --> Proxy: BackupFile[]
  Proxy --> Service: BackupFile[]

  Service -> Service: choose expired/extra backups

  loop For each backup to delete
    Service -> Proxy: delete(fileId)
    Proxy -> BG: runtime message DELETE\nprovider GOOGLE_DRIVE
    BG -> BG: get cached handler for GOOGLE_DRIVE
    BG -> Handler: delete(fileId)
    Handler -> Client: trashFile(fileId)
    Client -> Auth: getValidAccessToken()
    Auth --> Client: access token
    Client -> Google: PATCH /files/{fileId}\ntrashed: true
    Google --> Client: trashed file metadata
    Client --> Handler: ok
    Handler --> BG: ok
    BG --> Proxy: ok
    Proxy --> Service: ok
  end
end

Service --> UI: BackupCreateResult
UI -> User: Show "Backup created"

@enduml