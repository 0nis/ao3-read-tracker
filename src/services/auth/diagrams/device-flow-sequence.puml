@startuml Google Drive Device OAuth Flow
title Google Drive Device OAuth Flow

skinparam participant<<external>> {
    BackgroundColor #F3F3F3
    BorderColor #888888
}

actor User
participant UI [
    =Options Page UI
    ""content script""
]
participant Service [
    =AuthService
    ""service""
]
participant Proxy [
    =GoogleDeviceAuthProxy
    ""content-side proxy""
]
participant BG [
    =Auth Background
    ""message router""
]
participant Handler [
    =GoogleDeviceAuthHandler
    ""handler""
]
participant Client [
    =DeviceOAuthClient
    ""generic OAuth""
]
database "Extension Storage" as ExtStorage
database "IndexedDB Storage" as Storage

participant Google <<external>> [
    =Google OAuth
]

User -> UI: Click "Connect Google Drive"
UI -> Service: startDeviceFlow()\nprovider GOOGLE
Service -> Proxy: startDeviceFlow()
Proxy -> BG: runtime message\nSTART_DEVICE_FLOW
BG -> Handler: startDeviceFlow()
Handler -> Client: requestDeviceCode()
Client -> Google: POST /device/code\nclient_id + scope
Google --> Client: device_code + user_code\nverification_url + interval
Client --> Handler: normalized device code
Handler -> ExtStorage: store pending device flow
Handler --> BG: DeviceFlowStartResponse
BG --> Proxy: DeviceFlowStartResponse
Proxy --> Service: DeviceFlowStartResponse
Service --> UI: verificationUrl + userCode

UI -> User: Show code + Google URL
User -> Google: Open URL and enter code
Google -> User: Account selection + consent

loop Until approved or expired
  UI -> Service: pollDeviceFlow()
  Service -> Proxy: pollDeviceFlow()
  Proxy -> BG: runtime message\nPOLL_DEVICE_FLOW
  BG -> Handler: pollDeviceFlow()
  Handler -> ExtStorage: read pending device flow
  Handler -> Client: pollToken(deviceCode)
  Client -> Google: POST /token\ndevice_code + client credentials
  alt authorization pending
    Google --> Client: authorization_pending
    Client --> Handler: PENDING
    Handler --> BG: PENDING
    BG --> Proxy: PENDING
    Proxy --> Service: PENDING
  else approved
    Google --> Client: access_token + refresh_token
    Client --> Handler: token response
    Handler -> ExtStorage: store OAuth tokens
    Handler -> ExtStorage: clear pending device flow
    Handler --> BG: COMPLETE
    BG --> Proxy: COMPLETE
    Proxy --> Service: COMPLETE
    Service -> Storage: store provider connected state
    Service --> UI: COMPLETE
    UI -> User: Show "Connected"
  end
end

@enduml